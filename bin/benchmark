#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/state_jacket"
require "benchmark"

puts "StateJacket Performance Benchmark"
puts "=" * 50

# Simple two-state transition system for maximum performance
transitions = StateJacket::StateTransitionSystem.new
transitions.add state_a: [:state_b]
transitions.add state_b: [:state_a]

machine = StateJacket::StateMachine.new(transitions, state: :state_a)
machine.on :toggle, {state_a: :state_b, state_b: :state_a}
machine.lock

# Warm up
1000.times { machine.trigger(:toggle) }

# Benchmark different numbers of transitions
[1_000, 10_000, 100_000, 1_000_000].each do |count|
  formatted_count = count.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
  puts "\nPerforming #{formatted_count} total transitions:"
  
  # Reset to known state
  machine.trigger(:toggle) until machine.state == "state_a"
  
  time = Benchmark.realtime do
    count.times { machine.trigger(:toggle) }
  end
  
  transitions_per_second = (count / time).round
  formatted_tps = transitions_per_second.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
  
  puts "  Completed in: #{time.round(4)} seconds"
  puts "  Rate: #{formatted_tps} transitions/second"
end

puts "\n" + "=" * 50
puts "Benchmark completed successfully!"